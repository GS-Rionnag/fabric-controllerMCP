{
  "schemaVersion": 1,
  "id": "fabric_controller_mcp",
  "version": "${version}",
  "name": "Fabric Controller MCP",
  "description": "Client-side MCP controller for Minecraft Java Edition.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.fabriccontrollermcp.FabricControllerMcpClient"
    ]
  },
  "mixins": [
    "fabric-controller-mcp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}"
  }
}
